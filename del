<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CornerMart Convenience</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="logo">
        <span class="logo-mark">CM</span>
        <div>
          <p class="logo-title">CornerMart Convenience</p>
          <p class="logo-subtitle">Fuel up. Stock up. Print here.</p>
        </div>
      </div>
      <nav class="nav-links">
        <a href="#services">Services</a>
        <a href="#favorites">Store Favorites</a>
        <a href="#prints">Photo Prints</a>
        <a href="#visit">Visit Us</a>
      </nav>
      <button class="cta-button">Order Ahead</button>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Open 24/7 · Neighborhood convenience</p>
          <h1>Grab essentials fast — with full-service photo prints on the spot.</h1>
          <p class="hero-copy">
            From cold drinks and snacks to household basics, CornerMart keeps your day moving. Now offering
            same-day photo services, including passport-ready prints and instant gifts.
          </p>
          <div class="hero-actions">
            <button class="primary-button">See Today’s Deals</button>
            <button class="ghost-button">Print Pricing</button>
          </div>
        </div>
        <div class="hero-card">
          <div class="hero-image" role="img" aria-label="Convenience store shelves with snacks and drinks"></div>
          <div class="hero-highlights">
            <div>
              <h3>Fresh &amp; Ready</h3>
              <p>Hot coffee, bakery bites, and grab-and-go meals daily.</p>
            </div>
            <div>
              <h3>Express Checkout</h3>
              <p>Tap-to-pay, mobile wallet, and curbside pickup.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="prints" class="banner">
        <div>
          <p class="banner-label">New Service</p>
          <h2>Passport photograph prints available</h2>
          <p>
            Walk in with your photo or take one in store. We size, print, and cut to official requirements in
            minutes — just like the big pharmacies.
          </p>
        </div>
        <button class="primary-button">Start a Passport Print</button>
      </section>

      <section id="services" class="services">
        <h2>More ways we keep you moving</h2>
        <div class="service-grid">
          <article>
            <h3>Photo &amp; Gift Prints</h3>
            <p>4x6, 5x7, poster prints, and instant gift cards printed same-day.</p>
          </article>
          <article>
            <h3>Everyday Essentials</h3>
            <p>Pantry staples, batteries, chargers, and household must-haves.</p>
          </article>
          <article>
            <h3>Bill Pay &amp; Top Up</h3>
            <p>Reload prepaid cards, pay bills, and top up phone plans while you shop.</p>
          </article>
        </div>
      </section>

      <section id="favorites" class="favorites">
        <div>
          <h2>Store favorites, always stocked</h2>
          <p>
            Find popular local snacks, ice-cold drinks, and last-minute items curated for busy afternoons.
            Everything is right up front to get you in and out quickly.
          </p>
          <ul>
            <li>Energy drinks, smoothies, and fresh juice</li>
            <li>Sandwiches, salads, and hot food</li>
            <li>Over-the-counter essentials and travel items</li>
          </ul>
        </div>
        <div class="favorites-card">
          <h3>Today’s Highlight</h3>
          <p>Buy 2 bottled drinks, get 1 snack free after 4pm.</p>
          <button class="ghost-button">View Specials</button>
        </div>
      </section>

      <section id="visit" class="visit">
        <h2>Visit CornerMart today</h2>
        <div class="visit-grid">
          <div>
            <h3>Store Hours</h3>
            <p>Open 24/7, every day of the year.</p>
          </div>
          <div>
            <h3>Location</h3>
            <p>1458 Central Ave, Springfield</p>
          </div>
          <div>
            <h3>Contact</h3>
            <p>Call or text: (555) 018-4950</p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>CornerMart Convenience · Fast essentials &amp; photo printing you can trust.</p>
      <div class="footer-links">
        <a href="#prints">Passport Prints</a>
        <a href="#services">Services</a>
        <a href="#visit">Directions</a>
      </div>
    </footer>
  </body>
</html>
